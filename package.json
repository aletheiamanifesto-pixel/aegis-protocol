{
  "name": "aegis-protocol",
  "version": "0.1.0",
  "description": "AEGIS Protocol \u2014 MiCA-compliant EUR stablecoin smart contracts",
  "private": true,
  "scripts": {
    "compile": "hardhat compile",
    "test": "hardhat test",
    "deploy": "hardhat run scripts/deploy.js --network amoy",
    "deploy:sepolia": "hardhat run scripts/deploy_testnet.js --network sepolia",
    "deploy:local": "hardhat run scripts/deploy.js --network localhost",
    "test:circuits": "node --test noir_circuits/test/circuits.test.mjs noir_circuits/test/core.test.mjs",
    "build:circuits": "node scripts/build_circuits.mjs",
    "deploy:pool": "hardhat run scripts/deploy_pool.js --network amoy",
    "app": "python3 -m http.server 8080 --directory app/demo"
  },
  "devDependencies": {
    "@aztec/bb.js": "5.3.0",
    "@noir-lang/noir_js": "1.0.0",
    "@noir-lang/noir_wasm": "1.0.0",
    "@nomicfoundation/hardhat-toolbox": "^5.0.0",
    "dotenv": "^16.4.5",
    "hardhat": "^2.22.0"
  },
  "dependencies": {
    "@openzeppelin/contracts": "^5.0.2"
  }
}
