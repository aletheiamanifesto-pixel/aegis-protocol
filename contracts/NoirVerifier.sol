pragma solidity ^0.8.20;

/// @notice Interface of the UltraHonk verifiers generated by bb (scripts/build_circuits.mjs).
interface IHonkVerifier {
    function verify(bytes calldata proof, bytes32[] calldata publicInputs) external returns (bool);
}

/**
 * @title NoirVerifier
 * @notice Adapter between AegisEUR and the real UltraHonk verifier generated by bb.
 *
 * - Production: delegates to `backend` (contracts/verifiers/*Verifier.sol). Without a
 *   backend configured, EVERY proof is rejected. (The previous version accepted
 *   any `proof` whose first 32 bytes were keccak256(publicInputs): forgeable by anyone.)
 * - devMode (accepts any non-empty proof) can only be enabled on the local
 *   Hardhat chain (chainid 31337), never on testnet/mainnet.
 */
contract NoirVerifier {
    uint256 public constant LOCAL_CHAIN_ID = 31337;

    address public owner;
    bool public devMode;
    IHonkVerifier public backend;

    event BackendSet(address indexed backend);

    mapping(bytes32 => bool) public verifiedProofs;

    event ProofVerified(bytes32 indexed proofHash, bool result);
    event DevModeToggled(bool enabled);

    modifier onlyOwner() {
        require(msg.sender == owner, "Not owner");
        _;
    }

    constructor(bool _devMode) {
        require(!_devMode || block.chainid == LOCAL_CHAIN_ID, "devMode only on local chain");
        owner = msg.sender;
        devMode = _devMode;
    }

    /**
     * @notice Verify a ZK proof with public inputs.
     * @param proof        The proof bytes (generated by nargo prove).
     * @param publicInputs Array of public inputs as bytes32.
     * @return bool        True if the proof is valid.
     *
     * In production: Replace this function body with the output of
     * `nargo codegen-verifier` which generates a proper UltraPlonk verifier.
     */
    function verifyProof(
        bytes calldata proof,
        bytes32[] calldata publicInputs
    ) external returns (bool) {
        bytes32 proofHash = keccak256(abi.encodePacked(proof, publicInputs));

        bool result;
        if (devMode) {
            result = proof.length > 0;
        } else {
            result = _ultraPlonkVerify(proof, publicInputs);
        }

        if (result) {
            verifiedProofs[proofHash] = true;
        }

        emit ProofVerified(proofHash, result);
        return result;
    }

    /**
     * @notice Static view version of verifyProof (no state change, no event).
     */
    function verifyProofView(
        bytes calldata proof,
        bytes32[] calldata publicInputs
    ) external view returns (bool) {
        if (devMode) {
            return proof.length > 0;
        }
        return _ultraPlonkVerify(proof, publicInputs);
    }

    function isProofVerified(bytes32 proofHash) external view returns (bool) {
        return verifiedProofs[proofHash];
    }

    /// @notice The real verifier is set ONCE and cannot be replaced: the owner cannot later
    ///         swap in a permissive verifier. A new verifier means a new deploy.
    function setBackend(address _backend) external onlyOwner {
        require(address(backend) == address(0), "Backend already set");
        require(_backend != address(0) && _backend.code.length > 0, "Backend must be a contract");
        backend = IHonkVerifier(_backend);
        emit BackendSet(_backend);
    }

    function setDevMode(bool _devMode) external onlyOwner {
        require(!_devMode || block.chainid == LOCAL_CHAIN_ID, "devMode only on local chain");
        devMode = _devMode;
        emit DevModeToggled(_devMode);
    }

    /// @dev Real verification: delegates to the bb-generated verifier. No backend = rejected.
    function _ultraPlonkVerify(
        bytes calldata proof,
        bytes32[] calldata publicInputs
    ) internal view returns (bool) {
        if (address(backend) == address(0) || proof.length == 0) return false;
        // staticcall: the generated verifiers are view; this keeps verifyProofView view.
        (bool ok, bytes memory ret) = address(backend).staticcall(
            abi.encodeCall(IHonkVerifier.verify, (proof, publicInputs))
        );
        return ok && ret.length == 32 && abi.decode(ret, (bool));
    }
}
