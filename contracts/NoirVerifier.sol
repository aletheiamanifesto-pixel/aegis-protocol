pragma solidity ^0.8.20;

/**
 * @title NoirVerifier
 * @notice On-chain verifier for Noir ZK proofs.
 *
 * Note: The actual verification logic is generated by `nargo codegen-verifier`.
 * This is a stub verifier for testing/development. Replace with generated verifier in production.
 */
contract NoirVerifier {
    address public owner;
    bool public devMode;

    mapping(bytes32 => bool) public verifiedProofs;

    event ProofVerified(bytes32 indexed proofHash, bool result);
    event DevModeToggled(bool enabled);

    modifier onlyOwner() {
        require(msg.sender == owner, "Not owner");
        _;
    }

    constructor(bool _devMode) {
        owner = msg.sender;
        devMode = _devMode;
    }

    /**
     * @notice Verify a ZK proof with public inputs.
     * @param proof        The proof bytes (generated by nargo prove).
     * @param publicInputs Array of public inputs as bytes32.
     * @return bool        True if the proof is valid.
     *
     * In production: Replace this function body with the output of
     * `nargo codegen-verifier` which generates a proper UltraPlonk verifier.
     */
    function verifyProof(
        bytes calldata proof,
        bytes32[] calldata publicInputs
    ) external returns (bool) {
        bytes32 proofHash = keccak256(abi.encodePacked(proof, publicInputs));

        bool result;
        if (devMode) {
            result = proof.length > 0;
        } else {
            result = _ultraPlonkVerify(proof, publicInputs);
        }

        if (result) {
            verifiedProofs[proofHash] = true;
        }

        emit ProofVerified(proofHash, result);
        return result;
    }

    /**
     * @notice Static view version of verifyProof (no state change, no event).
     */
    function verifyProofView(
        bytes calldata proof,
        bytes32[] calldata publicInputs
    ) external view returns (bool) {
        if (devMode) {
            return proof.length > 0;
        }
        return _ultraPlonkVerify(proof, publicInputs);
    }

    function isProofVerified(bytes32 proofHash) external view returns (bool) {
        return verifiedProofs[proofHash];
    }

    function setDevMode(bool _devMode) external onlyOwner {
        devMode = _devMode;
        emit DevModeToggled(_devMode);
    }

    /**
     * @dev Placeholder for UltraPlonk verification.
     * Replace with: generated verifier contract code from `nargo codegen-verifier`.
     */
    function _ultraPlonkVerify(
        bytes calldata proof,
        bytes32[] calldata publicInputs
    ) internal pure returns (bool) {
        if (proof.length < 32) return false;
        if (publicInputs.length == 0) return false;

        bytes32 expectedCommitment = keccak256(abi.encodePacked(publicInputs));
        bytes32 proofCommitment;
        assembly {
            proofCommitment := calldataload(proof.offset)
        }

        return proofCommitment == expectedCommitment;
    }
}
