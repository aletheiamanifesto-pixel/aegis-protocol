pragma solidity ^0.8.24;

import {IERC20} from "@openzeppelin/contracts/token/ERC20/IERC20.sol";
import {SafeERC20} from "@openzeppelin/contracts/token/ERC20/utils/SafeERC20.sol";
import {Ownable2Step, Ownable} from "@openzeppelin/contracts/access/Ownable2Step.sol";
import {Pausable} from "@openzeppelin/contracts/utils/Pausable.sol";
import {ReentrancyGuard} from "@openzeppelin/contracts/utils/ReentrancyGuard.sol";
import {Poseidon2} from "./lib/Poseidon2.sol";

/// @notice Interface of the UltraHonk verifier generated by bb (contracts/verifiers/SpendVerifier.sol).
interface ISpendVerifier {
    function verify(bytes calldata proof, bytes32[] calldata publicInputs) external returns (bool);
}

/**
 * @title ShieldedPool
 * @notice Confidential pool (not anonymous) for an existing ERC-20 stablecoin (e.g. EURC).
 *
 * - Balances exist only as Poseidon2 commitments in a Merkle tree (depth 20).
 * - Every transaction carries a `spend` circuit proof that guarantees ownership,
 *   value conservation, no double spend and KYC compliance (credential signed
 *   by a registered issuer, allowed jurisdiction, tier limits).
 * - Every transaction publishes two verifiable ciphertexts (graduated disclosure):
 *   TAX (level 2) and AML (level 3), encrypted to threshold keys held by
 *   the compliance committee. Nobody sees the detail without a key, but the detail exists
 *   and is decryptable one transaction at a time.
 * - Controlled launch: TVL cap and maximum deposit per transaction.
 *
 * The owner must be a multisig behind a timelock (e.g. Safe + TimelockController).
 */
contract ShieldedPool is Ownable2Step, Pausable, ReentrancyGuard {
    using SafeERC20 for IERC20;

    uint256 public constant FIELD_SIZE = 21888242871839275222246405745257275088548364400416034343698204186575808495617;
    uint32 public constant TREE_DEPTH = 20;
    uint32 public constant ROOT_HISTORY_SIZE = 64;
    uint256 public constant NUM_PUBLIC_INPUTS = 39;
    uint256 public constant EPOCH_SECONDS = 1 days;
    uint256 public constant MAX_PROOF_AGE = 1 hours;

    struct Point {
        uint256 x;
        uint256 y;
    }

    /// @dev Must match the order of the public inputs and outputs of noir_circuits/spend.
    struct Proof {
        bytes proof;
        uint256 root;
        uint256[2] nullifiers;
        uint256[2] outCommitments;
        uint64 publicIn;
        uint64 publicOut;
        uint64 timestamp;
        Point issuer; // KYC issuer Schnorr-Grumpkin key
        Point taxEph;
        uint256[4] taxCt;
        Point amlEph;
        uint256[8] amlCt;
        uint256 rateNullifier; // one per (person, day, slot): caps the daily tx count PER PERSON
    }

    struct ExtData {
        address recipient; // receives publicOut - fee
        address relayer; // receives fee (lets you pay gas without exposing your own wallet)
        uint64 fee;
        bytes encryptedOutput0; // note for the recipient (encrypted off-chain to their key)
        bytes encryptedOutput1; // change note for the sender
    }

    IERC20 public immutable token;
    ISpendVerifier public immutable verifier;

    // ---- Merkle tree ----
    uint256[TREE_DEPTH + 1] public zeros;
    uint256[TREE_DEPTH] public filledSubtrees;
    uint256[ROOT_HISTORY_SIZE] public roots;
    uint32 public currentRootIndex;
    uint32 public nextIndex;

    mapping(uint256 => bool) public nullifierSpent;
    mapping(uint256 => bool) public rateNullifierUsed;

    // ---- Compliance policy ----
    mapping(bytes32 => bool) public issuerAllowed; // keccak256(x, y) → allowed
    uint64 public allowedJurisdictions;
    uint64[4] public tierLimits;
    /// @notice Max transactions per day per person (all pseudonyms together).
    uint32 public maxTxPerEpoch = 16;
    Point public taxKey;
    Point public amlKey;

    // ---- Controlled launch ----
    uint256 public tvlCap;
    uint256 public maxDepositPerTx;
    uint256 public totalDeposited; // EURC held by the pool

    event NewCommitment(uint256 indexed commitment, uint32 index, bytes encryptedOutput);
    event NewNullifier(uint256 indexed nullifier);
    event Disclosure(uint32 indexed leafIndex, Point taxEph, uint256[4] taxCt, Point amlEph, uint256[8] amlCt);
    event IssuerSet(bytes32 indexed id, bool allowed);
    event PolicyUpdated(uint64 allowedJurisdictions, uint64[4] tierLimits);
    event RateLimitUpdated(uint32 maxTxPerEpoch);
    event AuditorKeysUpdated(Point taxKey, Point amlKey);
    event LimitsUpdated(uint256 tvlCap, uint256 maxDepositPerTx);

    constructor(
        IERC20 _token,
        ISpendVerifier _verifier,
        address _owner,
        uint64 _allowedJurisdictions,
        uint64[4] memory _tierLimits,
        Point memory _taxKey,
        Point memory _amlKey,
        uint256 _tvlCap,
        uint256 _maxDepositPerTx
    ) Ownable(_owner) {
        require(address(_token) != address(0) && address(_verifier) != address(0), "zero address");
        token = _token;
        verifier = _verifier;

        uint256 z = 0;
        zeros[0] = 0;
        for (uint32 i = 0; i < TREE_DEPTH; i++) {
            filledSubtrees[i] = z;
            z = Poseidon2.hash2(z, z);
            zeros[i + 1] = z;
        }
        roots[0] = z;

        _setPolicy(_allowedJurisdictions, _tierLimits);
        _setAuditorKeys(_taxKey, _amlKey);
        tvlCap = _tvlCap;
        maxDepositPerTx = _maxDepositPerTx;
    }

    // ------------------------------------------------------------------
    // Main transaction: deposit, private transfer, withdrawal
    // ------------------------------------------------------------------

    function transact(Proof calldata p, ExtData calldata ext) external nonReentrant whenNotPaused {
        require(isKnownRoot(p.root), "unknown root");
        require(!nullifierSpent[p.nullifiers[0]] && !nullifierSpent[p.nullifiers[1]], "note already spent");
        require(issuerAllowed[keccak256(abi.encode(p.issuer.x, p.issuer.y))], "issuer not allowed");
        require(p.timestamp <= block.timestamp && block.timestamp - p.timestamp <= MAX_PROOF_AGE, "stale proof");
        require(!rateNullifierUsed[p.rateNullifier], "daily transaction limit reached");
        require(ext.fee <= p.publicOut, "fee above withdrawal");
        if (p.publicOut > 0) require(ext.recipient != address(0), "no recipient");

        if (p.publicIn > 0) {
            require(p.publicIn <= maxDepositPerTx, "deposit above per-tx limit");
            require(totalDeposited + p.publicIn <= tvlCap, "TVL cap reached");
        }

        require(verifier.verify(p.proof, _publicInputs(p, extDataHash(ext))), "invalid proof");

        rateNullifierUsed[p.rateNullifier] = true;
        nullifierSpent[p.nullifiers[0]] = true;
        nullifierSpent[p.nullifiers[1]] = true;
        emit NewNullifier(p.nullifiers[0]);
        emit NewNullifier(p.nullifiers[1]);

        uint32 index = _insertPair(p.outCommitments[0], p.outCommitments[1]);
        emit NewCommitment(p.outCommitments[0], index, ext.encryptedOutput0);
        emit NewCommitment(p.outCommitments[1], index + 1, ext.encryptedOutput1);
        emit Disclosure(index, p.taxEph, p.taxCt, p.amlEph, p.amlCt);

        if (p.publicIn > 0) {
            totalDeposited += p.publicIn;
            token.safeTransferFrom(msg.sender, address(this), p.publicIn);
        }
        if (p.publicOut > 0) {
            totalDeposited -= p.publicOut;
            token.safeTransfer(ext.recipient, p.publicOut - ext.fee);
            if (ext.fee > 0) token.safeTransfer(ext.relayer, ext.fee);
        }
    }

    function extDataHash(ExtData calldata ext) public pure returns (uint256) {
        uint256 h = uint256(keccak256(abi.encode(ext))) % FIELD_SIZE;
        return h == 0 ? 1 : h; // the circuit requires ext_data_hash != 0
    }

    /// @dev Same order as the public inputs + return values of noir_circuits/spend/src/main.nr.
    function _publicInputs(Proof calldata p, uint256 extHash) internal view returns (bytes32[] memory pi) {
        pi = new bytes32[](NUM_PUBLIC_INPUTS);
        uint256 k = 0;
        pi[k++] = bytes32(p.root);
        pi[k++] = bytes32(p.nullifiers[0]);
        pi[k++] = bytes32(p.nullifiers[1]);
        pi[k++] = bytes32(p.outCommitments[0]);
        pi[k++] = bytes32(p.outCommitments[1]);
        pi[k++] = bytes32(uint256(p.publicIn));
        pi[k++] = bytes32(uint256(p.publicOut));
        pi[k++] = bytes32(uint256(uint160(address(token))));
        pi[k++] = bytes32(extHash);
        pi[k++] = bytes32(uint256(p.timestamp));
        pi[k++] = bytes32(uint256(allowedJurisdictions));
        for (uint256 i = 0; i < 4; i++) pi[k++] = bytes32(uint256(tierLimits[i]));
        pi[k++] = bytes32(uint256(maxTxPerEpoch));
        pi[k++] = bytes32(p.issuer.x);
        pi[k++] = bytes32(p.issuer.y);
        pi[k++] = bytes32(taxKey.x);
        pi[k++] = bytes32(taxKey.y);
        pi[k++] = bytes32(amlKey.x);
        pi[k++] = bytes32(amlKey.y);
        pi[k++] = bytes32(p.taxEph.x);
        pi[k++] = bytes32(p.taxEph.y);
        for (uint256 i = 0; i < 4; i++) pi[k++] = bytes32(p.taxCt[i]);
        pi[k++] = bytes32(p.amlEph.x);
        pi[k++] = bytes32(p.amlEph.y);
        for (uint256 i = 0; i < 8; i++) pi[k++] = bytes32(p.amlCt[i]);
        pi[k++] = bytes32(p.rateNullifier);
        assert(k == NUM_PUBLIC_INPUTS);
    }

    // ------------------------------------------------------------------
    // Merkle tree
    // ------------------------------------------------------------------

    function _insertPair(uint256 leaf0, uint256 leaf1) internal returns (uint32 index) {
        index = nextIndex;
        require(index + 2 <= uint32(1) << TREE_DEPTH, "tree full");
        require(leaf0 < FIELD_SIZE && leaf1 < FIELD_SIZE, "leaf not in field");

        uint256 current = Poseidon2.hash2(leaf0, leaf1);
        uint32 pos = index >> 1;
        for (uint32 level = 1; level < TREE_DEPTH; level++) {
            if (pos & 1 == 0) {
                filledSubtrees[level] = current;
                current = Poseidon2.hash2(current, zeros[level]);
            } else {
                current = Poseidon2.hash2(filledSubtrees[level], current);
            }
            pos >>= 1;
        }
        uint32 newRootIndex = (currentRootIndex + 1) % ROOT_HISTORY_SIZE;
        currentRootIndex = newRootIndex;
        roots[newRootIndex] = current;
        nextIndex = index + 2;
    }

    function isKnownRoot(uint256 root) public view returns (bool) {
        if (root == 0) return false;
        uint32 i = currentRootIndex;
        for (uint32 n = 0; n < ROOT_HISTORY_SIZE; n++) {
            if (roots[i] == root) return true;
            i = i == 0 ? ROOT_HISTORY_SIZE - 1 : i - 1;
        }
        return false;
    }

    function getLastRoot() external view returns (uint256) {
        return roots[currentRootIndex];
    }

    // ------------------------------------------------------------------
    // Governance (owner = multisig + timelock)
    // ------------------------------------------------------------------

    /// @notice Register/remove a KYC issuer (Schnorr-Grumpkin key). Removing the key is the
    ///         emergency revocation: ALL its credentials stop working immediately.
    function setIssuer(uint256 x, uint256 y, bool allowed) external onlyOwner {
        require(!allowed || _onGrumpkin(Point(x, y)), "issuer key not on curve");
        bytes32 id = keccak256(abi.encode(x, y));
        issuerAllowed[id] = allowed;
        emit IssuerSet(id, allowed);
    }

    function setPolicy(uint64 _allowedJurisdictions, uint64[4] calldata _tierLimits) external onlyOwner {
        _setPolicy(_allowedJurisdictions, _tierLimits);
    }

    /// @notice Rotating the auditor keys only affects future transactions: the old ones stay
    ///         decryptable only with the old keys (which the committee must keep).
    function setAuditorKeys(Point calldata _taxKey, Point calldata _amlKey) external onlyOwner {
        _setAuditorKeys(_taxKey, _amlKey);
    }

    function setRateLimit(uint32 _maxTxPerEpoch) external onlyOwner {
        require(_maxTxPerEpoch > 0, "zero limit");
        maxTxPerEpoch = _maxTxPerEpoch;
        emit RateLimitUpdated(_maxTxPerEpoch);
    }

    function setLimits(uint256 _tvlCap, uint256 _maxDepositPerTx) external onlyOwner {
        tvlCap = _tvlCap;
        maxDepositPerTx = _maxDepositPerTx;
        emit LimitsUpdated(_tvlCap, _maxDepositPerTx);
    }

    function pause() external onlyOwner {
        _pause();
    }

    /// @notice There is no "freeze" of individual users inside the pool: the issuer simply stops
    ///         reissuing the (short-lived) KYC credential, and without a valid credential
    ///         the notes cannot be moved.
    function unpause() external onlyOwner {
        _unpause();
    }

    function _setPolicy(uint64 _allowedJurisdictions, uint64[4] memory _tierLimits) internal {
        allowedJurisdictions = _allowedJurisdictions;
        tierLimits = _tierLimits;
        emit PolicyUpdated(_allowedJurisdictions, _tierLimits);
    }

    function _setAuditorKeys(Point memory _taxKey, Point memory _amlKey) internal {
        require(_onGrumpkin(_taxKey) && _onGrumpkin(_amlKey), "auditor key not on curve");
        taxKey = _taxKey;
        amlKey = _amlKey;
        emit AuditorKeysUpdated(_taxKey, _amlKey);
    }

    /// @dev Grumpkin: y^2 = x^3 - 17 over the BN254 scalar field.
    function _onGrumpkin(Point memory pt) internal pure returns (bool) {
        if (pt.x >= FIELD_SIZE || pt.y >= FIELD_SIZE) return false;
        uint256 lhs = mulmod(pt.y, pt.y, FIELD_SIZE);
        uint256 rhs = addmod(mulmod(mulmod(pt.x, pt.x, FIELD_SIZE), pt.x, FIELD_SIZE), FIELD_SIZE - 17, FIELD_SIZE);
        return lhs == rhs;
    }
}
