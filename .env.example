# AEGIS Protocol — environment configuration template
# Copy this file to .env and fill in the values for your environment.

# JSON-RPC endpoint (local Hardhat/Anvil node or remote testnet)
RPC_URL=http://localhost:8545

# Canonical ERC-4337 EntryPoint (v0.7) — same address on most EVM chains
ENTRY_POINT_ADDR=0x5FF137D4b0FDCD49DcA30c7CF57E578a026d2789

# Deployed AegisSmartAccount proxy address (set after deployment)
SMART_ACCOUNT_ADDR=0x0000000000000000000000000000000000000000

# Private key used by the backend bundler to submit handleOps transactions
# WARNING: Never commit a real private key to source control.
BUNDLER_PRIVATE_KEY=0xac0974bec39a17e36ba4a6b4d238ff944bacb478cbed5efcae784d7bf4f2ff80

# Optional: override the path to the AegisSmartAccount ABI JSON file
# ABI_PATH=./aegis_smart_account_abi.json
