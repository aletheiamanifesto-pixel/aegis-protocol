# ──────────────────────────────────────────────────────────────
# AEGIS Protocol – Environment Variables
# Copy this file to .env and fill in your values.
# ──────────────────────────────────────────────────────────────

# ── Blockchain / RPC ─────────────────────────────────────────
# Get a free RPC URL from https://alchemy.com or https://infura.io
# Polygon Amoy example: https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY
# Sepolia example:      https://eth-sepolia.g.alchemy.com/v2/YOUR_API_KEY
RPC_URL=https://polygon-amoy.g.alchemy.com/v2/YOUR_API_KEY

# ── Deployer / Admin Wallet ──────────────────────────────────
# Create a NEW MetaMask wallet for development only.
# Export its private key (Settings → Security → Reveal Private Key).
# Fund it with testnet tokens from a faucet:
#   Polygon Amoy: https://faucet.polygon.technology/
#   Sepolia:      https://sepoliafaucet.com/
# ⚠️  NEVER use a wallet that holds real funds!
PRIVATE_KEY=0xYOUR_PRIVATE_KEY_HERE

# ── Deployed Contracts ───────────────────────────────────────
# After running the deploy script, paste the addresses here.
AEGIS_CONTRACT_ADDRESS=0xYOUR_DEPLOYED_AEGIS_ADDRESS

# ── Chain ID ─────────────────────────────────────────────────
# Polygon Amoy = 80002  |  Sepolia = 11155111
CHAIN_ID=80002
