# AEGIS Protocol – Environment Variables
# Copy this file to .env and fill in the values.

# ── Database ──────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://aegis:aegis@localhost:5432/aegis_db

# ── API Security ──────────────────────────────────────────────────────────
# Generate a strong random key: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me-in-production

ACCESS_TOKEN_EXPIRE_MINUTES=60

# ── Blockchain ────────────────────────────────────────────────────────────
RPC_URL=https://rpc-amoy.polygon.technology
# NEVER commit your real private key; use a dedicated backend-only key
PRIVATE_KEY=0x...

AEGIS_CONTRACT_ADDRESS=0x...
EURC_TOKEN_ADDRESS=0x...

# 80002 = Polygon Amoy testnet, 11155111 = Sepolia
CHAIN_ID=80002

# ── CORS ──────────────────────────────────────────────────────────────────
# Comma-separated list of allowed origins for the SPARK frontend
CORS_ORIGINS=http://localhost:3000
